PROJECT_NAME="DriveNow Car Rental API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (MySQL 8+)
# For local MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/car_rental"

# Security & Authentication
JWT_SECRET="drivenow_super_secret_jwt_key_car_rental_platform_2026_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Configuration (Frontend Vite default: http://localhost:8443)
CORS_ORIGINS="http://localhost:8443,http://localhost:5173,http://127.0.0.1:8443,http://127.0.0.1:5173"

# File Uploads (KYC)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=5242880

# Rate Limiting
AUTH_RATE_LIMIT_PER_MINUTE=10
ROADSIDE_RATE_LIMIT_PER_MINUTE=5
